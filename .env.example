# Copy to .env and fill in.  cp .env.example .env
# .env holds real secrets and is gitignored. THIS file is committed — placeholders only.

# --- Database (Neon) -------------------------------------------------------
# Neon dashboard → Connect. Pooled string (host has "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Unpooled / direct string (host without "-pooler"). Used by Prisma CLI for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js -------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- LLM (Google Gemini, free tier) -----------------------------------
# Key from https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=""
